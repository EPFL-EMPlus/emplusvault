[Unit]
Description=Uvicorn instance to serve the emplusvault API
After=network.target

[Service]
User=emplus
Group=emplus
WorkingDirectory=/home/emplus/emplusvault/rts/api
Environment="PATH=/home/emplus/.cache/pypoetry/virtualenvs/emv-tRKeAi0S-py3.11"
ExecStart=/home/emplus/.cache/pypoetry/virtualenvs/emv-tRKeAi0S-py3.11/bin/uvicorn server:app --host 0.0.0.0 --port 8763 --workers 24

[Install]
WantedBy=multi-user.target